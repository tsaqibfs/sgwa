# Copy to .env.docker and replace all four values. Keep secrets private.
# MYSQL_PASSWORD must use URL-safe characters: letters, digits, underscore, hyphen.
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_SECRET_AT_LEAST_32_CHARACTERS_LONG
DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD
